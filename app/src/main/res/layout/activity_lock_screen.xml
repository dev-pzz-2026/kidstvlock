<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lock_bg">

    <!-- ===================== 答题主界面 ===================== -->
    <LinearLayout
        android:id="@+id/layoutMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/tv_margin_h">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/screen_locked"
            android:textColor="@color/accent"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- 汉字/题目显示 -->
        <TextView
            android:id="@+id/tvCharacter"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="100sp"
            android:textStyle="bold"
            android:maxLines="4"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="24sp"
            android:autoSizeMaxTextSize="200sp"
            android:autoSizeStepGranularity="2sp"
            android:paddingHorizontal="32dp" />

        <!-- 题目文本 -->
        <TextView
            android:id="@+id/tvQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:gravity="center"
            android:paddingHorizontal="64dp"
            android:layout_marginVertical="4dp"
            android:lineSpacingExtra="6dp"
            android:maxLines="4"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeMaxTextSize="36sp"
            android:autoSizeStepGranularity="2sp" />

        <!-- 提问 -->
        <TextView
            android:id="@+id/tvAsk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/what_pronounce"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <!-- 选项按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginHorizontal="@dimen/tv_margin_h"
            android:layout_marginVertical="@dimen/spacing_small">

            <Button
                android:id="@+id/btnOption1"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:background="@drawable/btn_option_bg"
                android:textColor="@color/btn_text"
                android:textSize="26sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="32sp"
                android:autoSizeStepGranularity="2sp"
                android:singleLine="false"
                android:maxLines="2"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusLeft="@id/btnOption4"
                android:nextFocusRight="@id/btnOption2" />

            <Button
                android:id="@+id/btnOption2"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:background="@drawable/btn_option_bg"
                android:textColor="@color/btn_text"
                android:textSize="26sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="32sp"
                android:autoSizeStepGranularity="2sp"
                android:singleLine="false"
                android:maxLines="2"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btnOption3"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:background="@drawable/btn_option_bg"
                android:textColor="@color/btn_text"
                android:textSize="26sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="32sp"
                android:autoSizeStepGranularity="2sp"
                android:singleLine="false"
                android:maxLines="2"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btnOption4"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:background="@drawable/btn_option_bg"
                android:textColor="@color/btn_text"
                android:textSize="26sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="32sp"
                android:autoSizeStepGranularity="2sp"
                android:singleLine="false"
                android:maxLines="2"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusLeft="@id/btnOption3"
                android:nextFocusRight="@id/btnOption1" />

        </LinearLayout>

        <!-- 反馈文字 -->
        <TextView
            android:id="@+id/tvFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/correct_green"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingHorizontal="48dp"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:maxLines="4"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="22sp"
            android:autoSizeStepGranularity="2sp"
            android:visibility="gone" />

        <!-- 进度 -->
        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:layout_marginTop="@dimen/spacing_small" />

    </LinearLayout>

</FrameLayout>
